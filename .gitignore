# ==============================================================================
# SECRETS, CREDENTIALS & TOKENS (NEVER COMMIT)
# ==============================================================================
*.env*
*.secret
*private*.json
*token_cache*.json
tradovate_auth_tokens.json
tradovate_sim_tokens.json
state.json
runtime_state.json

# ==============================================================================
# LOCAL VPS RUNTIME DIRECTORIES & TEMPORARY SCRIPTS
# (These remain on the VPS disk for running services but are excluded from the clean code backup)
# ==============================================================================
tradovate_bot/
tradovate_bot_acc2/
ft_userdata/
src/
tests/
scratch/
permit2/
tradfi_bot/
jarvis_business_engine/
ai_copilot_bot/
telegram_vip_engine/
youtube-automation/

# Ignore root-level loose experiment scripts and data files
/*.py
/*.json

# Exclude sensitive configs inside backup folders (allow only config.example.json)
weex_crypto_bot/**/config.json
propfirm_bot_account1/config.json
propfirm_bot_account2/config.json

